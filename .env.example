# ============================================================
# AI 运维故障分析与脚本助手 —— 环境变量样例
# 使用方式：复制为 .env 后按需修改（cp .env.example .env）
# ============================================================

# ---------- 模型接入 ----------
# auto  = 有 Key 走真实模型，无 Key 自动降级为演示模式（默认，推荐）
# live  = 强制走真实模型（没有 Key 会退化为演示模式并告警）
# mock  = 强制演示模式，完全不发外部请求（离线开发/CI 用）
LLM_MODE=auto

# chat_completions = /v1/chat/completions（兼容性最好，推荐）
# responses        = /v1/responses（支持 previous_response_id 服务端托管会话）
LLM_PROTOCOL=chat_completions

# 留空即进入演示模式，界面与流程照样能完整跑通
OPENAI_API_KEY=

# OpenAI 官方：https://api.openai.com/v1
# 兼容中转示例：https://<your-gateway>/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

# ---------- Agent 编排 ----------
# 单次提问最多进行几轮「推理 -> 工具执行」，超出后强制收敛出结论
AGENT_MAX_TURNS=6
AGENT_MAX_HISTORY=40
TOOL_TIMEOUT_MS=8000

# ---------- 服务 ----------
PORT=8787
HOST=127.0.0.1

# ---------- 安全与审计 ----------
AUDIT_ENABLED=true
MAX_LOG_LINES=200

# ---------- 执行环境（阶段 4） ----------
# mock   = 模拟执行，逐行打印但不产生任何副作用（默认，演示/CI 推荐）
# docker = 一次性容器：docker run --rm --network=none + 内存/CPU/进程数限额
# local  = 受限解释器，只认只读命令与 shell 内建，绝不调用系统 shell
EXEC_MODE=mock

# EXEC_MODE=local 时需再显式确认一次（默认关闭，避免误开）
EXEC_ALLOW_LOCAL=false

# 演示时想让同一个人既能提交又能批准，设为 1；默认 0（提交人不可自批）
ALLOW_SELF_APPROVAL=0

# 前端需要独立 dev server 时才配置，例如 CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=
